# Copy to .env (git-ignored) and change the values. These are local-development placeholders,
# not secrets: never reuse them anywhere that matters.

# "dev" or "production". Anything that is not explicitly dev is treated as production.
DJANGO_ENV=dev
# DJANGO_ENV=dev only: a superuser for the admin, created on first start and never
# overwritten afterwards. Ignored, and impossible to create, in any other environment.
DEV_SUPERUSER_USERNAME=admin
DEV_SUPERUSER_PASSWORD=local-dev-only-replace-me

# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=local-dev-only-replace-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
# Set to true when a TLS-terminating proxy sits in front: enables HSTS, secure cookies, redirect.
DJANGO_BEHIND_TLS=false
LOG_LEVEL=INFO

POSTGRES_DB=vehicle_rentals
POSTGRES_USER=vehicle_rentals
POSTGRES_PASSWORD=local-dev-only-replace-me
# How long a booking waits for the car type lock, and how long any one statement may run,
# before the request fails instead of tying up a worker. Milliseconds; 0 means no limit.
POSTGRES_LOCK_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=15000
# Host port the database is published on (127.0.0.1 only). Change it if 5432 is taken.
POSTGRES_HOST_PORT=5432
